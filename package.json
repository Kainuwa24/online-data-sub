{
  "name": "online-data-sub",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:push": "prisma db push",
    "db:push:prod": "prisma db push --schema prisma/schema.postgres.prisma",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "db:generate:prod": "prisma generate --schema prisma/schema.postgres.prisma",
    "db:setup": "prisma db push && prisma generate",
    "cap:sync": "cap sync",
    "cap:android": "cap open android",
    "cap:copy": "cap copy android",
    "cap:sync:prod": "node -e \"if(!process.env.CAPACITOR_SERVER_URL&&!process.env.NEXT_PUBLIC_APP_URL){console.error('Set CAPACITOR_SERVER_URL or NEXT_PUBLIC_APP_URL to your Railway HTTPS origin');process.exit(1)}\" && cap sync android",
    "android:bundle": "cd android && node -e \"require('child_process').execSync(process.platform==='win32'?'gradlew.bat bundleRelease':'./gradlew bundleRelease',{stdio:'inherit'})\"",
    "android:apk": "cd android && node -e \"require('child_process').execSync(process.platform==='win32'?'gradlew.bat assembleRelease':'./gradlew assembleRelease',{stdio:'inherit'})\""
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.4.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@prisma/client": "^5.18.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.383.0",
    "next": "^14.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "undici": "^6.21.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/cli": "^8.4.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "prisma": "^5.18.0",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.2"
  }
}

# --- App ---
JWT_SECRET=replace-with-a-long-random-string
# Local: SQLite file (default). Production/Render/Railway: Postgres connection string.
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://user:password@localhost:5432/online_data_sub"
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Google Sign-In (optional alternate auth) ---
# Create OAuth client: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional override (defaults to NEXT_PUBLIC_APP_URL + /api/auth/google/callback)
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# --- Support (Help & support screen) ---
NEXT_PUBLIC_SUPPORT_EMAIL=support@onlinedatasub.app
NEXT_PUBLIC_SUPPORT_WHATSAPP=2348000000000

# --- Magic link email (optional; without this, links print to the server console) ---
# Free tier: https://resend.com
RESEND_API_KEY=
# Use onboarding@resend.dev until you verify a domain
EMAIL_FROM=Online Data Sub <onboarding@resend.dev>

# --- Termii (OTP / SMS) — https://termii.com ---
TERMII_API_KEY=
TERMII_SENDER_ID=OnlineDataSub

# --- ASBDATA (data / airtime / bills) — https://asbdata.com ---
# Postman: https://documenter.getpostman.com/view/12429346/UVe9QUS8
ASBDATA_BASE_URL=https://asbdata.com
ASBDATA_TOKEN=
# VTU | awuf4U | Share and Sell
ASBDATA_AIRTIME_TYPE=VTU
# Optional retail markup in naira on wholesale plan prices
ASBDATA_PLATFORM_MARKUP_NGN=0

# --- PalmPay (wallet funding via permanent virtual account) ---
PALMPAY_ENV=sandbox
# Live default: https://open-gw-prod.palmpay-inc.com
# Sandbox default: https://open-gw-sandbox.palmpay-inc.com
PALMPAY_BASE_URL=
PALMPAY_APP_ID=
PALMPAY_MERCHANT_PRIVATE_KEY=
PALMPAY_PUBLIC_KEY=
PALMPAY_MERCHANT_PUBLIC_KEY=
PALMPAY_COUNTRY_CODE=NG
PALMPAY_BANK_NAME=PalmPay

# --- GoldAPI (gold spot price) — https://www.goldapi.io ---
GOLDAPI_KEY=
# Fallback USD->NGN rate used only if no live forex source is wired up yet
USD_NGN_FALLBACK_RATE=1600

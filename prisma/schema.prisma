// Local development — SQLite (no Postgres server required).
// Production (Render): use schema.postgres.prisma via npm run db:push:prod

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(cuid())
  name            String
  /// Optional until Google user finishes /complete-profile
  phone           String?   @unique
  /// Optional until Google user finishes /complete-profile
  pinHash         String?
  referralCode    String    @unique
  referredBy      String?
  email           String?   @unique
  googleId        String?   @unique
  bvn             String?
  nin             String?
  phoneVerifiedAt DateTime?
  createdAt       DateTime  @default(now())

  wallet          Wallet?
  transactions    Transaction[]
  notifications   Notification[]
  virtualAccounts VirtualAccount[]
}

model Wallet {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // balance stored in kobo (1/100 naira) to avoid float rounding issues
  balanceKobo Int      @default(0)
  updatedAt   DateTime @updatedAt
}

model Transaction {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // DEBIT | CREDIT
  type       String
  // "data" | "airtime" | "electricity" | "cable_tv" | "internet" | "wallet_funding" | "referral"
  category   String
  label      String
  amountKobo Int
  // PENDING | SUCCESS | FAILED
  status     String   @default("PENDING")
  reference  String   @unique
  // JSON string for SQLite; Postgres schema uses Json
  meta       String?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
}

model OtpCode {
  id        String   @id @default(cuid())
  phone     String
  code      String
  // "signup" | "reset_pin"
  purpose   String
  expiresAt DateTime
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([phone, purpose])
}

/// One-time email magic-link login tokens (store only the hash)
model MagicLinkToken {
  id        String   @id @default(cuid())
  email     String
  tokenHash String   @unique
  expiresAt DateTime
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model Referral {
  id         String   @id @default(cuid())
  referrerId String
  referredId String   @unique
  bonusKobo  Int      @default(50000) // ₦500
  createdAt  DateTime @default(now())
}

/// PalmPay (or other) permanent virtual account for wallet funding
model VirtualAccount {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider         String   @default("palmpay")
  accountNumber    String
  bankName         String
  accountName      String
  accountReference String   @unique
  isPermanent      Boolean  @default(true)
  status           String   @default("ACTIVE")
  raw              String? // JSON string
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([userId, provider])
  @@index([accountNumber])
}

/// Idempotent provider webhook ledger (PalmPay orderNo, etc.)
model ProviderEvent {
  id              String    @id @default(cuid())
  externalEventId String    @unique
  provider        String
  reference       String
  status          String
  failureReason   String?
  payload         String? // JSON string
  processedAt     DateTime?
  createdAt       DateTime  @default(now())

  @@index([provider, reference])
}

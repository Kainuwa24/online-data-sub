// Production (Render Postgres). Used by: npm run db:generate:prod / db:push:prod

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(cuid())
  name            String
  phone           String?   @unique
  pinHash         String?
  referralCode    String    @unique
  referredBy      String?
  email           String?   @unique
  /// bcrypt hash for email/password accounts (null for Google-only users)
  passwordHash    String?
  googleId        String?   @unique
  bvn             String?
  nin             String?
  phoneVerifiedAt DateTime?
  createdAt       DateTime  @default(now())

  wallet          Wallet?
  transactions    Transaction[]
  notifications   Notification[]
  virtualAccounts VirtualAccount[]
}

model Wallet {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balanceKobo Int      @default(0)
  updatedAt   DateTime @updatedAt
}

model Transaction {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String
  category   String
  label      String
  amountKobo Int
  status     String   @default("PENDING")
  reference  String   @unique
  meta       String?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
}

model OtpCode {
  id        String   @id @default(cuid())
  phone     String
  code      String
  purpose   String
  expiresAt DateTime
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([phone, purpose])
}

model MagicLinkToken {
  id        String   @id @default(cuid())
  email     String
  tokenHash String   @unique
  expiresAt DateTime
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model Referral {
  id         String   @id @default(cuid())
  referrerId String
  referredId String   @unique
  bonusKobo  Int      @default(50000)
  createdAt  DateTime @default(now())
}

model VirtualAccount {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider         String   @default("palmpay")
  accountNumber    String
  bankName         String
  accountName      String
  accountReference String   @unique
  isPermanent      Boolean  @default(true)
  status           String   @default("ACTIVE")
  raw              String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([userId, provider])
  @@index([accountNumber])
}

model ProviderEvent {
  id              String    @id @default(cuid())
  externalEventId String    @unique
  provider        String
  reference       String
  status          String
  failureReason   String?
  payload         String?
  processedAt     DateTime?
  createdAt       DateTime  @default(now())

  @@index([provider, reference])
}
model AdminUser {
  id        String   @id @default(cuid())
  userId    String   @unique
  role      String   @default("READ_ONLY") // READ_ONLY | OPERATOR | FINANCE | OWNER
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role, active])
}

model AdminAuditLog {
  id           String   @id @default(cuid())
  actorAdminId String
  action       String
  targetType   String
  targetId     String?
  beforeJson   String?
  afterJson    String?
  metadata     String?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  @@index([actorAdminId, createdAt])
  @@index([targetType, targetId])
}

model WalletAdjustment {
  id                   String    @id @default(cuid())
  userId               String
  type                 String // CREDIT | DEBIT
  amountKobo           Int
  reason               String
  evidence             String?
  reference            String    @unique
  status               String    @default("PENDING") // PENDING | APPROVED | REJECTED | APPLIED
  createdByAdminId     String
  approvedByAdminId    String?
  rejectedByAdminId    String?
  appliedByAdminId     String?
  appliedTransactionId String?
  rejectionReason      String?
  createdAt            DateTime  @default(now())
  approvedAt           DateTime?
  rejectedAt           DateTime?
  appliedAt            DateTime?

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([createdByAdminId, createdAt])
}
/// Operator-managed profit margin applied to wholesale data plan prices.
/// Most specific match wins: plan code > (network + plan type) > network > global.
model PricingRule {
  id           String   @id @default(cuid())
  /// "GLOBAL" | "NETWORK" | "PLAN_TYPE" | "PLAN"
  scope        String
  /// MTN | Airtel | Glo | 9mobile — null for GLOBAL
  network      String?
  /// Normalized plan type (SME, GIFTING, …) — only for PLAN_TYPE scope
  planType     String?
  /// ASBDATA plan code — only for PLAN scope
  variationCode String?
  /// Margin as basis points (250 = 2.5%), applied to the wholesale price
  marginBps    Int      @default(0)
  /// Flat margin in kobo, added after the percentage margin
  marginKobo   Int      @default(0)
  /// Never charge below wholesale + this floor (kobo)
  minMarginKobo Int     @default(0)
  /// Optional cap on total margin (kobo); null = uncapped
  maxMarginKobo Int?
  /// Round the retail price up to this kobo multiple (e.g. 1000 = nearest ₦10)
  roundToKobo  Int      @default(0)
  active       Boolean  @default(true)
  note         String?
  createdByAdminId String
  updatedByAdminId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([scope, network, planType, variationCode])
  @@index([active, scope])
}


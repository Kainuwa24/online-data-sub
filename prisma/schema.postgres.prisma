// Production (Render Postgres). Used by: npm run db:generate:prod / db:push:prod

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(cuid())
  name            String
  phone           String?   @unique
  pinHash         String?
  referralCode    String    @unique
  referredBy      String?
  email           String?   @unique
  /// bcrypt hash for email/password accounts (null for Google-only users)
  passwordHash    String?
  googleId        String?   @unique
  bvn             String?
  nin             String?
  phoneVerifiedAt DateTime?
  createdAt       DateTime  @default(now())

  wallet          Wallet?
  transactions    Transaction[]
  notifications   Notification[]
  virtualAccounts VirtualAccount[]
}

model Wallet {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balanceKobo Int      @default(0)
  updatedAt   DateTime @updatedAt
}

model Transaction {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String
  category   String
  label      String
  amountKobo Int
  status     String   @default("PENDING")
  reference  String   @unique
  meta       String?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
}

model OtpCode {
  id        String   @id @default(cuid())
  phone     String
  code      String
  purpose   String
  expiresAt DateTime
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([phone, purpose])
}

model MagicLinkToken {
  id        String   @id @default(cuid())
  email     String
  tokenHash String   @unique
  expiresAt DateTime
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model Referral {
  id         String   @id @default(cuid())
  referrerId String
  referredId String   @unique
  bonusKobo  Int      @default(50000)
  createdAt  DateTime @default(now())
}

model VirtualAccount {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider         String   @default("palmpay")
  accountNumber    String
  bankName         String
  accountName      String
  accountReference String   @unique
  isPermanent      Boolean  @default(true)
  status           String   @default("ACTIVE")
  raw              String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([userId, provider])
  @@index([accountNumber])
}

model ProviderEvent {
  id              String    @id @default(cuid())
  externalEventId String    @unique
  provider        String
  reference       String
  status          String
  failureReason   String?
  payload         String?
  processedAt     DateTime?
  createdAt       DateTime  @default(now())

  @@index([provider, reference])
}
